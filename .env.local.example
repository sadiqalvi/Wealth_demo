# Offline / frontend-only: consumer app + API console use in-memory data (no pytrader-backend).
NEXT_PUBLIC_DEMO_API_MOCK=true

# Real backend: set NEXT_PUBLIC_DEMO_API_MOCK=false (or remove it).
# Local pyTrader:
# NEXT_PUBLIC_DEMO_API_BASE_URL=http://127.0.0.1:8000
# Deployed API (production builds default to https://api.pypsx.com if this is unset):
# NEXT_PUBLIC_DEMO_API_BASE_URL=https://api.pypsx.com
